APP_NAME=SoloTasks API
APP_ENV=development
API_PREFIX=/v1
API_BIND_HOST=127.0.0.1
API_HOST_PORT=8000
DB_BIND_HOST=127.0.0.1
DB_HOST_PORT=5432
MINIO_BIND_HOST=127.0.0.1
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

DATABASE_URL=postgresql+psycopg://solotasks:solotasks@db:5432/solotasks
JWT_SECRET=replace-with-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

OTP_LENGTH=6
OTP_EXPIRES_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_WINDOW=5
OTP_THROTTLE_WINDOW_MINUTES=30
OTP_FROM_EMAIL=no-reply@example.com

SMTP_HOST=mail.nodecmb.com
SMTP_PORT=465
SMTP_USERNAME=solotasks@nodecmb.com
SMTP_PASSWORD=Nodecmb@2k26
SMTP_USE_TLS=true

STORAGE_PROVIDER=s3
STORAGE_BUCKET=solotasks
STORAGE_REGION=us-east-1
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET_KEY=minioadmin123
STORAGE_LOCAL_ROOT=/data/storage

MAX_IMAGE_BYTES=20971520
MAX_PDF_BYTES=31457280
TOMBSTONE_RETENTION_DAYS=30
DEFAULT_TIMEZONE=Asia/Colombo
